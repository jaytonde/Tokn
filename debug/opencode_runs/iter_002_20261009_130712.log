import torch, triton, triton.language as tl

@triton.jit
def redk(x_ptr, out_ptr, n: tl.constexpr, MODE: tl.constexpr, NW: tl.constexpr):
    row = tl.program_id(0)
    offs = row*n + tl.arange(0, n)
    v = tl.load(x_ptr + offs)
    if MODE == 0:
        s = tl.sum(v*v, axis=0)
    elif MODE == 1:
        v2 = tl.reshape(v, (n//2, 2))
        s = tl.sum(tl.sum(v2*v2, axis=1), axis=0)
    elif MODE == 2:
        v4 = tl.reshape(v, (n//4, 4))
        s = tl.sum(tl.sum(v4*v4, axis=1), axis=0)
    elif MODE == 3:
        v8 = tl.reshape(v, (n//8, 8))
        s = tl.sum(tl.sum(v8*v8, axis=1), axis=0)
    elif MODE == 4:
        vh = tl.reshape(v, (2, n//2))
        s = tl.sum(tl.sum(vh*vh, axis=0), axis=0)
    tl.store(out_ptr + row, s)

torch.manual_seed(1)
dev='cuda'
for n in [128, 1024]:
    x = torch.randn(200, n, device=dev, dtype=torch.float32) * 8.0
    ref = (x*x).mean(-1)  # torch
    for mode in [0,1,2,3,4]:
        for nw in [1,2,4,8]:
            out = torch.zeros(200, device=dev, dtype=torch.float32)
            redk[(200,)](x, out, n, mode, nw, num_warps=nw)
            nd = (out != ref).sum().item()
            if nd == 0:
                print(f"MATCH n={n} mode={mode} num_warps={nw}")
print("done")
EOF
