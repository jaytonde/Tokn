import torch, sys
sys.path.insert(0,'/home/Tokn')
from layers.layernorm import RMSNorm
torch.manual_seed(0)
dev='cuda'; dtype=torch.bfloat16
m = RMSNorm(1024, eps=1e-6).to(dev, dtype)
x = torch.randn(5,1024, device=dev, dtype=dtype)
res = torch.randn(5,1024, device=dev, dtype=dtype)*2

# reference (old torch impl)
