The Triton reduction order differs from torch. Let me test whether some `num_warps` setting matches torch's reduction (both use strided thread assignment).
[0m$ [0mcat > /tmp/redtest2.py <<'EOF'
import torch, triton, triton.language as tl

@triton.jit
def sumk(x_ptr, out_ptr, n: tl.constexpr, NW: tl.constexpr):
    offs = tl.program_id(0) * n + tl.arange(0, n)
    v = tl.load(x_ptr + offs).to(tl.float32)
    tl.store(out_ptr + tl.program_id(0), tl.sum(v * v, axis=0))

n=1024
x = torch.randn(128, n, device='cuda', dtype=torch.bfloat16) * 8.0
ref = (x.float()**2).sum(-1)
for nw in [1,2,4,8,16,32]:
    out = torch.zeros(128, device='cuda', dtype=torch.float32)
    sumk[(128,)](x, out, n, num_warps=nw)
    md = (out - ref).abs().max().item()
    nd = (out != ref).sum().item()
    print(f'num_warps={nw}: max|d|= {md:.6g} n_diff={nd}/128')
EOF
