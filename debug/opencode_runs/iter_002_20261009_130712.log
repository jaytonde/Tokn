import torch, triton, triton.language as tl

@triton.jit
def rms_with_var(x_ptr, w_ptr, y_ptr, var_ptr, n: tl.constexpr, eps):
    offs = tl.program_id(0) * n + tl.arange(0, n)
    x = tl.load(x_ptr + offs).to(tl.float32)
    var = tl.load(var_ptr + tl.program_id(0))
    inv = 1.0 / tl.sqrt(var + eps)
    w = tl.load(w_ptr + tl.arange(0, n))
    x_bf = (x * inv).to(x_ptr.dtype.element_ty)
    tl.store(y_ptr + offs, x_bf * w)

torch.manual_seed(0)
dev='cuda'; dt=torch.bfloat16
x = torch.randn(5, 1024, device=dev, dtype=dt) * 3.0
w = torch.randn(1024, device=dev, dtype=dt)
var = (x.float()**2).mean(-1)  # torch var
y = torch.zeros_like(x)
rms_with_var[(5,)](x, w, y, var, 1024, 1e-6)

ref = x.float()
ref = ref * torch.rsqrt(var.unsqueeze(-1) + 1e-6)
ref = ref.to(dt) * w
print('with torch var: y bit_eq =', torch.equal(y, ref), ' max|d|=', (y.float()-ref.float()).abs().max().item())
