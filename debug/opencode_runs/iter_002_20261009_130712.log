import torch, triton, triton.language as tl

@triton.jit
def sumk(x_ptr, out_ptr, n: tl.constexpr):
    offs = tl.program_id(0) * n + tl.arange(0, n)
    v = tl.load(x_ptr + offs).to(tl.float32)
    tl.store(out_ptr + tl.program_id(0), tl.sum(v * v, axis=0))

for n in [128, 256, 512, 1024, 2048]:
    x = torch.randn(64, n, device='cuda', dtype=torch.bfloat16) * 8.0
    out = torch.zeros(64, device='cuda', dtype=torch.float32)
    sumk[(64,)](x, out, n)
    ref = (x.float()**2).sum(-1)
    md = (out - ref).abs().max().item()
    n_diff = (out != ref).sum().item()
    print(f'n={n}: triton vs torch max|d|= {md:.6g} n_diff={n_diff}/64')
