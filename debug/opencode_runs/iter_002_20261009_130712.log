import torch, triton, triton.language as tl

@triton.jit
def rsqk(v_ptr, o1_ptr, o2_ptr, n: tl.constexpr):
    offs = tl.arange(0, n)
    v = tl.load(v_ptr + offs)
    tl.store(o1_ptr + offs, tl.rsqrt(v + 1e-6))
    tl.store(o2_ptr + offs, 1.0 / tl.sqrt(v + 1e-6))

v = torch.rand(4096, device='cuda', dtype=torch.float32) * 100 + 0.001
o1 = torch.zeros(4096, device='cuda', dtype=torch.float32)
o2 = torch.zeros(4096, device='cuda', dtype=torch.float32)
rsqk[(1,)](v, o1, o2, 4096)
ref = torch.rsqrt(v + 1e-6)
print('tl.rsqrt vs torch.rsqrt: bit_eq=', torch.equal(o1, ref), ' max|d|=', (o1-ref).abs().max().item())
print('1/tl.sqrt vs torch.rsqrt: bit_eq=', torch.equal(o2, ref), ' max|d|=', (o2-ref).abs().max().item())
# also torch 1/sqrt
print('torch 1/sqrt vs torch.rsqrt: bit_eq=', torch.equal(1.0/torch.sqrt(v+1e-6), ref))
EOF
