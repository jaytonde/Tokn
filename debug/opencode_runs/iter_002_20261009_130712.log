import torch, triton, triton.language as tl
import sys
sys.path.insert(0,'/home/Tokn')

@triton.jit
def rms_scale_kernel(x_ptr, var_ptr, w_ptr, y_ptr, n: tl.constexpr, eps, HAS_RES: tl.constexpr):
    row = tl.program_id(0)
    offs = row*n + tl.arange(0, n)
    x = tl.load(x_ptr + offs).to(tl.float32)
    var = tl.load(var_ptr + row)
    inv = 1.0 / tl.sqrt(var + eps)
    w = tl.load(w_ptr + tl.arange(0, n))
    x_bf = (x * inv).to(x_ptr.dtype.element_ty)
    tl.store(y_ptr + offs, x_bf * w)

torch.manual_seed(0)
dev='cuda'; dt=torch.bfloat16
n=1024
x = torch.randn(5, n, device=dev, dtype=dt) * 3.0
res = torch.randn(5, n, device=dev, dtype=dt) * 2.0
w = torch.randn(n, device=dev, dtype=dt)
eps=1e-6

# old torch impl (reference)
def old_rms(x, res):
    if res is not None:
        xf = x.float().add_(res.float())
        r = xf.to(dt)
        var = xf.pow(2).mean(-1, keepdim=True)
        xf.mul_(torch.rsqrt(var+eps))
        return xf.to(dt).mul_(w), r
    xf = x.float()
    var = xf.pow(2).mean(-1, keepdim=True)
    xf.mul_(torch.rsqrt(var+eps))
    return xf.to(dt).mul_(w), None

# new: torch computes var, triton does elementwise
def new_rms(x, res):
    xf = x.float()
    if res is not None:
        xf = xf + res.float()
        r = xf.to(dt)
        var = (xf*xf).mean(-1, keepdim=True)
    else:
        var = (xf*xf).mean(-1, keepdim=True)
        r = None
    y = torch.empty_like(x)
    rms_scale_kernel[(5,)](xf, var.view(-1), w, y, n, eps, res is not None)
    return y, r

for use_res in [False, True]:
    oy, orr = old_rms(x, res if use_res else None)
    ny, nrr = new_rms(x, res if use_res else None)
    print(f'residual={use_res}: y bit_eq={torch.equal(oy, ny)} max|d|={(oy.float()-ny.float()).abs().max().item()}')
    if use_res:
        print(f'  residual bit_eq={torch.equal(orr, nrr)}')
