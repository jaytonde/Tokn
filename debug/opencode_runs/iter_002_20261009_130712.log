import torch, sys
sys.path.insert(0,'/home/Tokn')
from layers.rotary_embedding import apply_rotary_emb, RotaryEmbedding
torch.manual_seed(0)
dev='cuda'; dt=torch.bfloat16
# reference torch impl
def ref_apply(x, cos, sin):
    x1, x2 = torch.chunk(x.float(), 2, dim=-1)
    y1 = x1 * cos - x2 * sin
    y2 = x2 * cos + x1 * sin
    return torch.cat((y1, y2), dim=-1).to(x.dtype)

# test various shapes: (num_tokens, num_heads, head_dim)
for (nt, nh, hd) in [(5,16,128),(5,8,128),(1,16,128),(483,16,128),(37,16,128)]:
    x = torch.randn(nt, nh, hd, device=dev, dtype=dt) * 0.5
    half = hd//2
    cos = torch.randn(nt, 1, half, device=dev, dtype=dt)
    sin = torch.randn(nt, 1, half, device=dev, dtype=dt)
    got = apply_rotary_emb(x, cos, sin)
    ref = ref_apply(x, cos, sin)
    print(f'shape={(nt,nh,hd)}: bit_eq={torch.equal(got, ref)} max|d|={(got.float()-ref.float()).abs().max().item()}')

# test through the module with real cos_sin_cache
emb = RotaryEmbedding(128, 128, 4096*32, 10000.0).to(dev, dt)
for (nt, nh, hd, maxpos) in [(5,16,128,500),(483,16,128,1200)]:
    pos = torch.tensor(list(range(nt)), device=dev, dtype=torch.long)
    q = torch.randn(nt, nh, hd, device=dev, dtype=dt)
    k = torch.randn(nt, 8, hd, device=dev, dtype=dt)
    qo, ko = emb(pos, q, k)
    cs = emb.cos_sin_cache[pos]
    c, s = cs.chunk(2, dim=-1)
    qr = ref_apply(q, c, s)
    kr = ref_apply(k, c, s)
    print(f'module shape={(nt,nh,hd)}: q bit_eq={torch.equal(qo, qr)} k bit_eq={torch.equal(ko, kr)}')
EOF
